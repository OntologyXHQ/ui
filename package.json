{
  "name": "ontologyx-ui-workspace",
  "version": "0.1.0-beta.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": "10.15.0"
  },
  "scripts": {
    "dev": "pnpm catalog:generate && pnpm --filter @ontologyx/ui-studio dev",
    "build": "pnpm --filter @ontologyx/ui build && pnpm --filter @ontologyx/ui-studio build",
    "check": "pnpm gate:architecture && pnpm gate:types",
    "test": "pnpm --filter @ontologyx/ui test && pnpm --filter @ontologyx/ui docs:test",
    "quality": "pnpm gate:architecture && pnpm gate:catalog && pnpm gate:types && pnpm gate:behavior",
    "verify": "pnpm quality && pnpm gate:studio && pnpm gate:browser",
    "release:check": "pnpm verify && node scripts/check-studio-production.mjs && pnpm package:smoke",
    "gate:architecture": "python3 scripts/gates/check-architecture.py",
    "gate:catalog": "pnpm catalog:check && node scripts/gates/check-catalog-acceptance.mjs",
    "gate:types": "pnpm --filter @ontologyx/ui check && pnpm --filter @ontologyx/ui-studio check",
    "gate:behavior": "pnpm --filter @ontologyx/ui test && pnpm --filter @ontologyx/ui docs:test",
    "gate:studio": "python3 scripts/gates/check-studio.py",
    "gate:build": "pnpm --filter @ontologyx/ui build && pnpm --filter @ontologyx/ui pack:check && pnpm --filter @ontologyx/ui-studio build",
    "lint": "biome check .",
    "format": "biome format --write .",
    "catalog:generate": "pnpm --filter @ontologyx/ui docs:generate",
    "catalog:check": "pnpm --filter @ontologyx/ui docs:check",
    "package:smoke": "node scripts/package-smoke.mjs",
    "package:tarball": "node scripts/create-tarball.mjs",
    "studio:build": "pnpm catalog:generate && pnpm --filter @ontologyx/ui-studio build && node scripts/check-studio-production.mjs",
    "studio:preview": "pnpm --filter @ontologyx/ui-studio preview",
    "snapshot": "node scripts/create-snapshot.mjs",
    "gate:browser": "pnpm gate:build && node scripts/browser/run-browser-acceptance.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "axe-core": "4.13.0",
    "playwright-core": "1.62.1"
  }
}

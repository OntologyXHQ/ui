{
  "name": "@oxs/ui",
  "version": "0.1.0",
  "description": "OXS UI platform: foundations, primitives, components, system UI, and runtime-neutral interaction contracts.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": [
    "./dist/styles.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./advanced": {
      "types": "./dist/advanced.d.ts",
      "import": "./dist/advanced.js",
      "default": "./dist/advanced.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node scripts/clean-build.mjs",
    "dev": "vite build --watch",
    "build:js": "vite build",
    "build:types": "tsc -p tsconfig.build.json --pretty false",
    "build:finalize": "node scripts/finalize-build.mjs",
    "build": "pnpm run clean && pnpm run build:js && pnpm run build:types && pnpm run build:finalize",
    "check": "tsc --noEmit -p tsconfig.json --pretty false",
    "test": "node scripts/check-host-safety.mjs && vitest run --config vitest.config.ts",
    "docs:generate": "node scripts/generate-catalog.mjs",
    "docs:check": "node scripts/generate-catalog.mjs --check",
    "docs:test": "node scripts/test-catalog.mjs",
    "pack:check": "node scripts/check-package.mjs",
    "prepack": "pnpm run build && pnpm run pack:check"
  },
  "peerDependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@typescript/typescript6": "6.0.2",
    "@vitejs/plugin-react": "6.0.5",
    "jsdom": "30.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
